  />
</div>
{{end}}

{{define "wg_textarea.tmpl"}}
<div class="border-b border-gray-100 py-4 last:border-b-0 dark:border-[rgba(148,163,184,0.06)]">
  <label class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">{{.Label}}</label>
  <textarea
    id="{{.ID}}"
    rows="2"
    class="w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 transition-colors focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 dark:border-[rgba(148,163,184,0.085)] dark:bg-[var(--np-muted)] dark:text-gray-100 dark:focus:border-emerald-600"
    placeholder="{{.Placeholder}}"
