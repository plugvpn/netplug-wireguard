{{define "ui.tmpl"}}
{{template "base.tmpl" .}}
{{end}}

{{define "ui.content"}}
<div class="h-full flex flex-col overflow-hidden">
  {{template "page_header.tmpl" .}}

  <div class="flex-1 overflow-y-auto">
    <div class="p-8">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">
          <div
            id="overview-connections"
            hx-get="/partials/overview/connections"
            hx-trigger="load, every 10s"
            hx-swap="innerHTML"
          ></div>
          <div
            id="overview-transfer"
            hx-get="/partials/overview/transfer"
            hx-trigger="load"
            hx-swap="innerHTML"
          ></div>
        </div>
        <div
          class="lg:col-span-1"
          id="overview-server"
          hx-get="/partials/overview/server"
          hx-trigger="load, every 10s"
          hx-swap="innerHTML"
        ></div>
      </div>
    </div>
  </div>
</div>
{{end}}

{{define "ui.header_right"}}
<div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
  <div class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
  <span>Synced every 30s</span>
</div>
<button
  class="flex items-center gap-2 rounded border border-gray-300 px-4 py-1.5 text-sm font-normal text-gray-600 transition-colors hover:bg-gray-50 hover:border-gray-400 disabled:opacity-50 dark:border-[rgba(148,163,184,0.09)] dark:text-gray-400 dark:hover:bg-[var(--np-muted)] dark:hover:border-[rgba(148,163,184,0.12)]"
  hx-get="/partials/overview/live"
  hx-swap="none"
  type="button"
>
  <i data-lucide="refresh-cw" class="h-4 w-4" style="stroke-width:1.5"></i>
  Refresh
</button>
{{end}}
