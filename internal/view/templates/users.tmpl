{{define "users.tmpl"}}
{{template "base.tmpl" .}}
{{end}}

{{define "users.content"}}
<div class="h-full flex flex-col overflow-hidden">
  {{template "page_header.tmpl" .}}
  <div class="flex-1 overflow-y-auto">
    <div class="p-8">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">VPN Users</h2>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Manage VPN user accounts and their access to WireGuard servers</p>
        </div>
        <button
          class="flex items-center gap-2 rounded-lg bg-gradient-to-r from-emerald-500 to-teal-500 px-4 py-2.5 font-semibold text-white transition-all hover:from-emerald-600 hover:to-teal-600"
          hx-get="/partials/users/add-modal"
          hx-target="#modal-root"
          hx-swap="innerHTML"
          type="button"
        >
          <i data-lucide="plus" class="h-4 w-4"></i>
          Add User
        </button>
      </div>

      {{if .Users}}
      <div class="mb-6">
        <div class="relative">
          <i data-lucide="search" class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
          <input
            id="users-search"
            type="text"
            placeholder="Search by username or IP address..."
            class="w-full rounded-lg border border-gray-300 bg-white py-3 pl-10 pr-4 text-sm text-gray-900 placeholder-gray-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 dark:border-[rgba(148,163,184,0.09)] dark:bg-[var(--np-muted)] dark:text-gray-100 dark:placeholder-gray-500"
          />
        </div>
      </div>
      {{end}}

      <div class="overflow-hidden rounded border border-[rgba(148,163,184,0.055)]" style="background-color:var(--np-panel);">
        <div class="border-b border-[rgba(148,163,184,0.06)] bg-gradient-to-r from-[var(--np-raised)] to-[var(--np-panel)] p-6">
          <h3 class="text-base font-normal text-white">All Users ({{len .Users}})</h3>
        </div>
        <style>
          /* Avoid Tailwind arbitrary colors in class names (CDN/JIT quirks) */
          tr.users-row {
            transition: background-color 0.15s ease-out;
          }
          tr.users-row:nth-child(odd) {
            background-color: var(--np-panel);
          }
          tr.users-row:nth-child(even) {
            background-color: #0a0d12;
          }
          tr.users-row:hover {
            background-color: rgba(148, 163, 184, 0.065) !important;
          }
          th.users-sortable {
            cursor: pointer;
            user-select: none;
            white-space: nowrap;
          }
          th.users-sortable:hover {
            color: #e5e7eb;
          }
          th.users-sortable .users-sort-icon {
            display: inline-block;
            margin-left: 0.35rem;
            opacity: 0.35;
            vertical-align: middle;
          }
          th.users-sortable.users-sort-active .users-sort-icon {
            opacity: 1;
            color: #34d399;
          }
        </style>
        <div class="overflow-x-auto" style="background-color:var(--np-panel); scrollbar-width:thin; scrollbar-color:#374151 var(--np-panel);">
          <table id="users-table" class="w-full" style="background-color:var(--np-panel);">
            <thead style="background-color:var(--np-raised);">
              <tr class="border-b border-[rgba(148,163,184,0.07)] text-left text-sm font-medium text-gray-300 dark:text-gray-400">
                <th class="users-sortable px-6 py-3" data-sort-key="username" data-sort-type="text">Username<span class="users-sort-icon">↕</span></th>
                <th class="users-sortable px-6 py-3" data-sort-key="ip" data-sort-type="ip">IP Address<span class="users-sort-icon">↕</span></th>
                <th class="users-sortable px-6 py-3" data-sort-key="status" data-sort-type="number">Status<span class="users-sort-icon">↕</span></th>
                <th class="users-sortable px-8 py-3" data-sort-key="usage" data-sort-type="number">Total Usage<span class="users-sort-icon">↕</span></th>
                <th class="users-sortable px-6 py-3" data-sort-key="remaining-days" data-sort-type="number">Remaining Days<span class="users-sort-icon">↕</span></th>
                <th class="users-sortable px-6 py-3" data-sort-key="remaining-traffic" data-sort-type="number">Remaining Traffic<span class="users-sort-icon">↕</span></th>
                <th class="px-6 py-3">Connection</th>
                <th class="px-6 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="users-tbody" class="divide-y divide-[rgba(148,163,184,0.045)]" style="background-color:var(--np-panel);">
              {{if not .Users}}
              <tr>
                <td class="px-6 py-6 text-sm text-gray-500 dark:text-gray-500" colspan="8">No users found.</td>
              </tr>
              {{end}}
              {{range $i, $u := .Users}}
              <tr
                class="users-row"
                data-username="{{$u.Username}}"
                data-ip="{{$u.IPAddress}}"
                data-status="{{if $u.IsEnabled}}1{{else}}0{{end}}"
                data-usage="{{addInt64 $u.TotalRxBytes $u.TotalTxBytes}}"
                data-remaining-days="{{if $u.HasRemainingDays}}{{$u.RemainingDaysValue}}{{else}}9223372036854775807{{end}}"
                data-remaining-traffic="{{if $u.HasRemainingTraffic}}{{$u.RemainingTrafficBytes}}{{else}}9223372036854775807{{end}}"
              >
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-700 dark:bg-[var(--np-muted)]">
                      <i data-lucide="user" class="h-5 w-5 text-gray-300 dark:text-gray-400"></i>
                    </div>
                    <div>
                      <p class="font-medium text-gray-100 dark:text-gray-100">{{$u.Username}}</p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  {{if $u.IPAddress}}
                    <span class="font-mono text-sm font-medium text-emerald-400 dark:text-emerald-400">{{$u.IPAddress}}</span>
                  {{else}}
                    <span class="text-sm text-gray-500 dark:text-gray-500">Not assigned</span>
                  {{end}}
                </td>
                <td class="px-6 py-4">
                  <form method="post" action="/ui/users/{{$u.ID}}/toggle">
                    <button
                      type="submit"
                      class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold transition-all {{if $u.IsEnabled}}border-emerald-700 bg-emerald-950 text-emerald-400 hover:bg-emerald-900 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-400{{else}}border-gray-600 bg-gray-800 text-gray-400 hover:bg-gray-700 dark:border-[rgba(148,163,184,0.085)] dark:bg-[var(--np-muted)] dark:text-gray-400{{end}}"
                      title="Toggle enabled"
                    >
                      <span class="h-1.5 w-1.5 rounded-full {{if $u.IsEnabled}}bg-emerald-500{{else}}bg-gray-400{{end}}"></span>
                      {{if $u.IsEnabled}}Enabled{{else}}Disabled{{end}}
                    </button>
                  </form>
                </td>
                <td class="px-8 py-4">
                  <div class="text-sm text-gray-300 dark:text-gray-400">
                    <div>↑ {{humanBytes $u.TotalRxBytes}}</div>
                    <div>↓ {{humanBytes $u.TotalTxBytes}}</div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm text-gray-200 dark:text-gray-200">
                    {{if $u.HasRemainingDays}}{{printf "%d days" $u.RemainingDaysValue}}{{else}}∞{{end}}
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="text-sm text-gray-200 dark:text-gray-200">
                    {{if $u.HasRemainingTraffic}}{{humanBytes $u.RemainingTrafficBytes}}{{else}}∞{{end}}
                  </span>
                </td>
                <td class="px-6 py-4">
                  {{if $u.IsConnected}}
                    <div class="flex items-center gap-2">
                      <i data-lucide="activity" class="h-4 w-4 text-emerald-400 dark:text-emerald-400"></i>
                      <div>
                        <p class="text-sm font-medium text-gray-200 dark:text-gray-200">Connected</p>
                        {{if $u.Endpoint}}
                          <p class="text-xs text-gray-500 dark:text-gray-500 font-mono">{{$u.Endpoint}}</p>
                        {{end}}
                      </div>
                    </div>
                  {{else}}
                    {{if $u.LastHandshakeAgo}}
                      <div class="flex items-center gap-2">
                        <i data-lucide="clock" class="h-4 w-4 shrink-0 text-gray-500 dark:text-gray-500" style="stroke-width:1.5"></i>
                        <span class="text-sm text-gray-400 dark:text-gray-400">{{$u.LastHandshakeAgo}}</span>
                      </div>
                    {{else}}
                      <span class="text-sm text-gray-500 dark:text-gray-500">Never</span>
                    {{end}}
                  {{end}}
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center justify-end gap-2">
                    <button
                      type="button"
                      class="rounded-md border border-emerald-700 p-2 text-emerald-400 transition-colors hover:bg-emerald-950 dark:border-emerald-900 dark:text-emerald-400 dark:hover:bg-emerald-950"
                      title="Show QR code"
                      hx-get="/partials/users/{{$u.ID}}/qr-modal"
                      hx-target="#modal-root"
                      hx-swap="innerHTML"
                    >
                      <i data-lucide="qr-code" class="h-4 w-4"></i>
                    </button>
                    <button
                      class="rounded-md border border-gray-600 p-2 text-gray-300 transition-colors hover:bg-[#1e2d42] dark:border-[rgba(148,163,184,0.085)] dark:text-gray-400 dark:hover:bg-[var(--np-muted)]"
                      title="Edit user"
                      type="button"
                      hx-get="/partials/users/{{$u.ID}}/edit-modal"
                      hx-target="#modal-root"
                      hx-swap="innerHTML"
                    >
                      <i data-lucide="edit-3" class="h-4 w-4"></i>
                    </button>
                    <button
                      class="rounded-md border border-red-700 p-2 text-red-400 transition-colors hover:bg-red-950 dark:border-red-900 dark:text-red-400 dark:hover:bg-red-950"
                      title="Delete user"
                      type="button"
                      hx-get="/partials/users/{{$u.ID}}/delete-modal"
                      hx-target="#modal-root"
                      hx-swap="innerHTML"
                    >
                      <i data-lucide="trash-2" class="h-4 w-4"></i>
                    </button>
                  </div>
                </td>
              </tr>
              {{end}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div id="modal-root"></div>
</div>

<script>
  (function () {
    const input = document.getElementById('users-search');
    const tbody = document.getElementById('users-tbody');
    const sortHeaders = document.querySelectorAll('th.users-sortable');
    let sortKey = 'username';
    let sortDir = 'asc';

    function norm(s) {
      return (s || '').toString().toLowerCase().trim();
    }

    function ipSortValue(ip) {
      var s = norm(ip);
      if (!s) return -1;
      var host = s.split('/')[0];
      var parts = host.split('.');
      if (parts.length !== 4) return s;
      var n = 0;
      for (var i = 0; i < 4; i++) {
        var p = parseInt(parts[i], 10);
        if (isNaN(p)) return s;
        n = (n * 256) + p;
      }
      return n;
    }

    function rowValue(row, key, type) {
      var raw = row.getAttribute('data-' + key) || '';
      if (type === 'text') return norm(raw);
      if (type === 'ip') return ipSortValue(raw);
      var num = parseFloat(raw);
      return isNaN(num) ? -1 : num;
    }

    function compareRows(a, b, key, type, dir) {
      var av = rowValue(a, key, type);
      var bv = rowValue(b, key, type);
      var cmp = 0;
      if (typeof av === 'string' || typeof bv === 'string') {
        var as = String(av);
        var bs = String(bv);
        cmp = as.localeCompare(bs, undefined, { numeric: true, sensitivity: 'base' });
      } else if (av < bv) {
        cmp = -1;
      } else if (av > bv) {
        cmp = 1;
      }
      return dir === 'desc' ? -cmp : cmp;
    }

    function updateSortIndicators() {
      sortHeaders.forEach(function (th) {
        var active = th.getAttribute('data-sort-key') === sortKey;
        th.classList.toggle('users-sort-active', active);
        var icon = th.querySelector('.users-sort-icon');
        if (icon) icon.textContent = active ? (sortDir === 'asc' ? '↑' : '↓') : '↕';
      });
    }

    function sortRows() {
      if (!tbody) return;
      var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr.users-row'));
      var th = document.querySelector('th.users-sortable[data-sort-key="' + sortKey + '"]');
      var type = th ? (th.getAttribute('data-sort-type') || 'text') : 'text';
      rows.sort(function (a, b) { return compareRows(a, b, sortKey, type, sortDir); });
      rows.forEach(function (row) { tbody.appendChild(row); });
      updateSortIndicators();
    }

    sortHeaders.forEach(function (th) {
      th.addEventListener('click', function () {
        var key = th.getAttribute('data-sort-key');
        if (!key) return;
        if (sortKey === key) {
          sortDir = sortDir === 'asc' ? 'desc' : 'asc';
        } else {
          sortKey = key;
          sortDir = 'asc';
        }
        sortRows();
      });
    });

    if (input) {
      input.addEventListener('input', function () {
        const q = norm(input.value);
        const rows = document.querySelectorAll('tr.users-row');
        rows.forEach(function (row) {
          const u = norm(row.getAttribute('data-username'));
          const ip = norm(row.getAttribute('data-ip'));
          const ok = !q || u.includes(q) || ip.includes(q);
          row.style.display = ok ? '' : 'none';
        });
      });
    }

    sortRows();
  })();
</script>
{{end}}

{{define "users.header_right"}}{{end}}

