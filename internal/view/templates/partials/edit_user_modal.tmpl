{{define "partials/edit_user_modal.tmpl"}}
<div class="fixed inset-0 z-50 flex items-center justify-center">
  <div
    class="absolute inset-0 bg-black/60 backdrop-blur-sm"
    hx-get="/partials/empty"
    hx-target="#modal-root"
    hx-swap="innerHTML"
  ></div>

  <div class="relative w-full max-w-md rounded-md border border-[rgba(148,163,184,0.06)] bg-[var(--np-panel)] shadow-none max-h-[calc(100vh-3rem)] overflow-hidden">
    <div class="flex items-start justify-between border-b border-[rgba(148,163,184,0.055)] px-6 py-4">
      <div>
        <div class="text-sm font-semibold text-gray-100">Edit User</div>
        <div class="text-xs text-gray-400">Update VPN user account</div>
      </div>
      <button
        class="rounded p-1.5 text-gray-400 hover:bg-[#1e2d42] hover:text-gray-200"
        hx-get="/partials/empty"
        hx-target="#modal-root"
        hx-swap="innerHTML"
        type="button"
      >
        <i data-lucide="x" class="h-4 w-4"></i>
      </button>
    </div>

    <form
      method="post"
      action="/ui/users/{{.UserID}}/edit"
      hx-post="/ui/users/{{.UserID}}/edit"
      hx-target="#modal-root"
      hx-swap="innerHTML"
      class="px-6 py-4 space-y-4 overflow-y-auto"
      style="max-height: calc(100vh - 11rem);"
    >
      <div>
        <label class="block text-xs font-medium text-gray-300 mb-2">Username *</label>
        <div class="flex items-center gap-2">
          <div class="flex h-9 w-9 items-center justify-center rounded border border-[rgba(148,163,184,0.09)] bg-[#1e2d42] text-gray-400">
            <i data-lucide="user" class="h-4 w-4" style="stroke-width:1.5"></i>
          </div>
          <input
            name="username"
            value="{{.Username}}"
            placeholder="john_doe"
            class="flex-1 h-9 rounded border border-[rgba(148,163,184,0.09)] bg-[#0a0d12] px-3 text-sm text-gray-100 placeholder:text-gray-500 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
            required
          />
        </div>
        <div class="mt-2 text-[11px] text-gray-500">
          Must be unique. Changing username updates this peer everywhere in the dashboard.
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-xs font-medium text-gray-300">Private Key *</label>
          <button
            type="button"
            onclick="modalGenerateKeys()"
            class="inline-flex items-center gap-1 rounded bg-emerald-600/20 px-2.5 py-1 text-[11px] font-medium text-emerald-300 hover:bg-emerald-600/30"
          >
            <i data-lucide="key-round" class="h-3.5 w-3.5" style="stroke-width:1.5"></i>
            Generate Keys
          </button>
        </div>
        <div class="relative">
          <input
            id="modal_private_key"
            name="private_key"
            type="password"
            value="{{.PrivateKey}}"
            autocomplete="off"
            class="w-full h-9 rounded border border-[rgba(148,163,184,0.09)] bg-[#0a0d12] px-3 pr-20 font-mono text-[11px] text-gray-100 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
          />
          <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
            <button type="button" onclick="modalTogglePk()" class="rounded p-1 text-gray-400 hover:bg-[#1e2d42] hover:text-gray-200" title="Show/hide private key">
              <i data-lucide="eye" class="h-4 w-4" style="stroke-width:1.5"></i>
            </button>
            <button type="button" onclick="modalCopy('modal_private_key')" class="rounded p-1 text-gray-400 hover:bg-[#1e2d42] hover:text-gray-200" title="Copy private key">
              <i data-lucide="copy" class="h-4 w-4" style="stroke-width:1.5"></i>
            </button>
          </div>
        </div>
        <div class="mt-1 text-[11px] text-gray-500">
          {{if .ImportedNoPrivKey}}Imported peer: paste the client private key or generate a new key pair (this updates the stored public key).{{else if .PrivateKey}}Use the eye icon to reveal the stored key. Generating new keys rotates this peer — clients must update their config.{{else}}WireGuard private key (auto-generated or manually entered){{end}}
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-300 mb-2">Public Key *</label>
        <input
          id="modal_public_key"
          name="public_key"
          readonly
          value="{{.PublicKey}}"
          class="w-full h-9 rounded border border-[rgba(148,163,184,0.09)] bg-[#152031] px-3 font-mono text-[11px] text-gray-300"
        />
        <div class="mt-1 text-[11px] text-gray-500">Automatically derived from the private key</div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-xs font-medium text-gray-300">Preshared Key (Optional)</label>
          <button
            type="button"
            onclick="modalGeneratePSK()"
            class="inline-flex items-center gap-1 rounded bg-purple-600/20 px-2.5 py-1 text-[11px] font-medium text-purple-300 hover:bg-purple-600/30"
          >
            <i data-lucide="sparkles" class="h-3.5 w-3.5" style="stroke-width:1.5"></i>
            Generate PSK
          </button>
        </div>
        <div class="relative">
          <input
            id="modal_psk"
            name="preshared_key"
            type="password"
            value="{{.PresharedKey}}"
            placeholder="Optional: enhance security with PSK"
            autocomplete="off"
            class="w-full h-9 rounded border border-[rgba(148,163,184,0.09)] bg-[#0a0d12] px-3 pr-20 font-mono text-[11px] text-gray-100 placeholder:text-gray-600 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
          />
          <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
            <button type="button" onclick="modalTogglePsk()" class="rounded p-1 text-gray-400 hover:bg-[#1e2d42] hover:text-gray-200" title="Show/hide preshared key">
              <i data-lucide="eye" class="h-4 w-4" style="stroke-width:1.5"></i>
            </button>
            <button type="button" onclick="modalCopy('modal_psk')" class="rounded p-1 text-gray-400 hover:bg-[#1e2d42] hover:text-gray-200" title="Copy preshared key">
              <i data-lucide="copy" class="h-4 w-4" style="stroke-width:1.5"></i>
            </button>
          </div>
        </div>
        <div class="mt-1 text-[11px] text-gray-500">
          Optional: adds an extra layer of symmetric encryption. Generate or edit anytime — clients must match the saved PSK.
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-300 mb-2">VPN IP Address *</label>
        <input
          id="modal_vpn_ip"
          name="vpn_ip"
          value="{{.VPNIP}}"
          readonly
          class="w-full h-9 rounded border border-[rgba(148,163,184,0.09)] bg-[#152031] px-3 text-sm text-gray-300 font-mono"
        />
        <div class="mt-1 text-[11px] text-gray-500">IP address cannot be changed after creation</div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-300 mb-2">Allowed IPs</label>
        <input
          id="modal_allowed_extra"
          name="allowed_ips_extra"
          value="{{.AllowedExtra}}"
          placeholder="192.168.0.0/16, 10.0.0.0/8, 0.0.0.0/0, ::/0"
          class="w-full h-9 rounded border border-[rgba(148,163,184,0.09)] bg-[#0a0d12] px-3 text-sm text-gray-100 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
        />
        <div class="mt-1 text-[11px] text-gray-500">
          Optional extra prefixes for this peer's AllowedIPs line in wg0.conf (after the tunnel IP above). Comma-separated CIDRs.
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-300 mb-2">Remaining Days (Optional)</label>
        <input
          name="remaining_days"
          value="{{.RemainingDays}}"
          placeholder="Leave empty for unlimited"
          class="w-full h-9 rounded border border-[rgba(148,163,184,0.09)] bg-[#0a0d12] px-3 text-sm text-gray-100 placeholder:text-gray-600 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
        />
        <div class="mt-1 text-[11px] text-gray-500">Number of days until account expires</div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-300 mb-2">Remaining Traffic (MB, Optional)</label>
        <input
          name="remaining_traffic_mb"
          type="number"
          min="0"
          value="{{.RemainingTrafficMB}}"
          placeholder="Leave empty for unlimited"
          class="w-full h-9 rounded border border-[rgba(148,163,184,0.09)] bg-[#0a0d12] px-3 text-sm text-gray-100 placeholder:text-gray-600 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
        />
        <div class="mt-1 text-[11px] text-gray-500">Maximum data transfer limit in megabytes</div>
      </div>

      <div class="rounded border border-[rgba(148,163,184,0.048)] bg-[#0a0d12] px-4 py-3">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-sm font-medium text-gray-100">User Status</div>
            <div class="text-xs text-gray-400">Enable or disable this user</div>
          </div>
          <label class="relative inline-flex cursor-pointer items-center">
            <input name="is_enabled" type="checkbox" class="peer sr-only" {{if .IsEnabled}}checked{{end}} />
            <div class="peer h-6 w-11 rounded-full bg-gray-700 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-emerald-500 peer-checked:after:translate-x-full"></div>
          </label>
        </div>
      </div>

      <div class="pt-2 flex items-center gap-3">
        <button
          type="button"
          class="flex-1 h-9 rounded border border-[rgba(148,163,184,0.09)] bg-[#152031] text-sm text-gray-200 hover:bg-[#1e2d42]"
          hx-get="/partials/empty"
          hx-target="#modal-root"
          hx-swap="innerHTML"
        >
          Cancel
        </button>
        <button class="flex-1 h-9 rounded bg-emerald-600 text-sm font-medium text-white hover:bg-emerald-500">
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    try { lucide.createIcons(); } catch (e) {}

    const pk = document.getElementById('modal_private_key');
    if (pk) {
      let t = null;
      pk.addEventListener('input', function () {
        if (t) clearTimeout(t);
        t = setTimeout(modalDerivePublicKey, 400);
      });
    }
  })();
</script>
{{end}}

